{
  "name": "guose-fanghua-scrolls",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate:assets": "node scripts/validate-assets.mjs && node scripts/validate-assets.mjs --assets-dir public/assets/new-scrolls --report-dir reports/new-scrolls",
    "validate:new-assets": "node scripts/validate-new-scroll-assets.mjs",
    "test": "node scripts/validate-viewing.mjs",
    "test:new-narrative": "node scripts/validate-new-narrative.mjs",
    "test:new-motion": "node scripts/validate-new-motion.mjs",
    "test:new-runtime": "node scripts/validate-new-scroll-runtime.mjs",
    "test:new-journey": "node scripts/validate-new-scroll-journey.mjs",
    "test:startup": "node scripts/validate-startup.mjs",
    "test:study": "npm run test:new-journey",
    "test:study-legacy": "node scripts/validate-study-journey.mjs",
    "test:study-renderer": "node scripts/validate-study-renderer.mjs",
    "test:study-timing": "node scripts/validate-study-timing.mjs",
    "test:layered-home": "npm run test:projection-home",
    "test:volume-home": "node scripts/validate-volume-home.mjs",
    "test:faithful-home": "node scripts/validate-faithful-home.mjs",
    "test:projection-home": "node scripts/validate-projection-home.mjs",
    "test:projection-home:static": "node scripts/validate-projection-home.mjs --static-only",
    "test:subpath": "node scripts/validate-subpath.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
