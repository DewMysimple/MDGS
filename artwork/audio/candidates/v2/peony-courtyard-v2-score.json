  "sections": [
    {
      "name": "山野初醒",
      "startBeat": 0,
      "endBeat": 32,
      "intention": "疏落拨弦，像晨光初入一庭花木。"
    },
    {
      "name": "花入人间",
      "startBeat": 32,
      "endBeat": 64,
      "intention": "旋律稍向上生长，箫意长音在远处应答。"
    },
    {
      "name": "锦绣寄意",
      "startBeat": 64,
      "endBeat": 96,
      "intention": "回到温暖中低音区，把留白交还给画面。"
    },
    {
      "name": "国色余韵",
      "startBeat": 96,
      "endBeat": 128,
      "intention": "动机舒展后缓缓归根，余音接回新的一轮。"
    }
  ],
